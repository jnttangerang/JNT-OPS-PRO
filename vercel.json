{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?reqPath=$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index?reqPath=uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
